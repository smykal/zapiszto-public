<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="20251005-01-add-executed-columns-to-exercises" author="yourname">
        <addColumn tableName="exercises">
            <column name="executed" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="executed_set_datetime" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="executed_set_by" type="bigint">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="exercises"
                baseColumnNames="executed_set_by"
                constraintName="fk_exercises_executed_set_by_user_roles"
                referencedTableName="user_roles"
                referencedColumnNames="user_id"
                onDelete="SET NULL"/>
    </changeSet>
</databaseChangeLog>