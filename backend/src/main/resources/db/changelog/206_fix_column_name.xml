<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ================= rename photo_id to body_photo_id ================= -->
    <changeSet id="rename-photo-id-to-body-photo-id-01" author="smykalm">

        <!-- drop constraints -->
        <dropForeignKeyConstraint
                baseTableName="body_photos_share"
                constraintName="fk_body_photos_share_photo"/>

        <dropUniqueConstraint
                tableName="body_photos_share"
                constraintName="uq_body_photos_share_photo_user"/>

        <!-- rename column -->
        <renameColumn
                tableName="body_photos_share"
                oldColumnName="photo_id"
                newColumnName="body_photo_id"
                columnDataType="uuid"/>

        <!-- recreate foreign key -->
        <addForeignKeyConstraint
                constraintName="fk_body_photos_share_body_photo"
                baseTableName="body_photos_share"
                baseColumnNames="body_photo_id"
                referencedTableName="body_photos"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- recreate unique constraint -->
        <addUniqueConstraint
                tableName="body_photos_share"
                columnNames="body_photo_id, user_id"
                constraintName="uq_body_photos_share_body_photo_user"/>

    </changeSet>

</databaseChangeLog>
