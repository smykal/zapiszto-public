<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="cascade-delete-goals" author="smykalm">
        <!-- Drop existing foreign key constraint -->
        <dropForeignKeyConstraint baseTableName="goals"
                                  constraintName="goals_client_id_fk"/>

        <!-- Add new foreign key constraint with ON DELETE CASCADE -->
        <addForeignKeyConstraint baseTableName="goals"
                                 baseColumnNames="client_id"
                                 constraintName="goals_client_id_fk"
                                 referencedTableName="clients"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
